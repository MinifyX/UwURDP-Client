{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UwURDP",
  "version": "0.1.0-beta.3",
  "identifier": "app.uwurdp.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UwURDP",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost ws://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQTE4NThFRjg1M0FFMDgKUldRSXJsUDRqb1doclBkVkhLUGZFYUVFbDlXektBRHVpMjlXTjJua0RNbGx2UGM0cU9GK0Q4Q3oK",
      "endpoints": ["https://raw.githubusercontent.com/MinifyX/UwURDP-Client/updates/beta.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "UwURDP",
    "homepage": "https://github.com/MinifyX/UwURDP-Client",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "GPL-3.0-only",
    "license": "GPL-3.0-only",
    "shortDescription": "Remote desktop client with self-hosted encrypted sync",
    "longDescription": "The remote desktop client I build for myself, because every other one annoyed me. RDCMan-dense, Termius-clean, with a sync server that is yours.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/uwurdp.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/uwurdp.desktop"
      }
    }
  }
}
